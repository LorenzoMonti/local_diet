# Nomi dei due utenti creati al primo avvio (modificabili poi dalla pagina Profilo)
USER_NAMES=Persona 1,Persona 2

# --- Modello -------------------------------------------------------------------
# "openai" = qualunque API compatibile OpenAI (Gemini, Groq, OpenRouter, Mistral, Ollama…)
# "claude" = Claude API (a pagamento)
LLM_PROVIDER=openai

# OpenRouter: chiave da https://openrouter.ai/settings/keys
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
# Modello di default (facoltativo): si sceglie dalla pagina ⚙️ Impostazioni della piattaforma
LLM_MODEL=

# Alternative (sostituisci le righe sopra):
#   Gemini:  LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/   (chiave: https://aistudio.google.com/apikey)
#   Groq:    LLM_BASE_URL=https://api.groq.com/openai/v1
#   Ollama (in locale sull'AGX, tutto offline):
#            LLM_BASE_URL=http://host.docker.internal:11434/v1   LLM_API_KEY=ollama   LLM_MODEL=gemma4:26b
#            e PII_MODE=off

# Opzionali (non tutti i provider li accettano)
# LLM_REASONING_EFFORT=medium
# LLM_MAX_TOKENS=32000

# Per usare Claude: LLM_PROVIDER=claude, ANTHROPIC_API_KEY=sk-ant-..., LLM_MODEL=claude-opus-5-5
# ANTHROPIC_API_KEY=

# --- Anonimizzazione dei referti ---------------------------------------------------
# rizzo = rizzo-pii + regole (avvia con: docker compose --profile pii up -d)
# rules = solo regole locali
# off   = nessuna (ha senso solo se il modello gira in locale, es. Ollama)
PII_MODE=rizzo
PII_SERVICE_URL=http://rizzo-pii:5005
# Tag lasciati in chiaro: età/sesso servono per i range di riferimento, AMOUNT evita di oscurare i valori
PII_KEEP_TAGS=AGE,GENDER,AMOUNT

# Porta su cui pubblicare la piattaforma (default 8000)
# DIETA_PORT=8000
